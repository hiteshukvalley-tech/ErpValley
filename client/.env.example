# Copy to .env.local for local overrides, and add the same variables in your hosting provider's build settings.
# Only VITE_* variables reach the browser, so never put real secrets in this file.

# Public address of the website, used for canonical URLs and social links.
VITE_SITE_URL=https://erpvalley.in

# Web3Forms access key (free at https://web3forms.com). Contact, demo, quote and newsletter forms are emailed
# to the address you registered the key with. Without it, the forms show a "not connected yet" message.
# The key is safe to expose: it can only send messages to your inbox.
VITE_WEB3FORMS_KEY=

# Google Tag Manager container ID (GTM > Admin > Container settings), e.g. GTM-XXXXXXX.
# Leave empty and no tracking code is added. GA4, Meta Pixel and other tags are set up inside GTM, not here.
# Read at build time: rebuild and redeploy after changing it.
VITE_GTM_ID=
# Set to false to switch tracking off for an environment (e.g. staging) without removing the ID.
VITE_GTM_ENABLED=true
