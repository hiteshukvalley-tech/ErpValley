# Copy to .env.local for local overrides. Only VITE_* variables reach the browser,
# so never put secrets (database URLs, API keys) in this file.

# Public address of the website, used for canonical URLs and social links.
VITE_SITE_URL=https://erpvalley.in

# API address. Default /api (proxied to the server during development). Use "off" to use only the bundled content.
# VITE_API_URL=https://api.erpvalley.in/api
