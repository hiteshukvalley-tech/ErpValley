# Copy to server/.env and fill in. Never commit .env: it contains your database password.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include the database name after the host, e.g. ...mongodb.net/erpvalley?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/erpvalley?retryWrites=true&w=majority

PORT=5301
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated). The Vite dev server runs on 5300.
CORS_ORIGIN=http://localhost:5300

# Set to 1 when running behind a single reverse proxy / load balancer.
TRUST_PROXY=0
